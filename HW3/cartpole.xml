<!--
  Cart-pole for ROB 6323 HW3, loaded by both MuJoCo and Pinocchio.
  Explicit inertials everywhere, no damping / armature / frictionloss, so the
  two parsers cannot disagree.  Cart M = 1.0 kg; pole: uniform rod,
  m = 0.2 kg, l = 0.6 m, CoM at l/2, inertia m*l^2/12 = 0.006 about its CoM.
  The rail geom and the light are visual only (no mass, no contact).

  timestep and ctrlrange are overwritten at load time (load_models) from
  PARAMS['dt'] and PARAMS['u_max'] in the Python script, so the simulator and
  the OCP always share them.
-->
<mujoco model="cartpole">
  <option timestep="0.02" integrator="Euler" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 -3 3" dir="0 1 -1"/>
    <geom name="rail" type="box" size="2 0.01 0.01" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>
    <body name="cart" pos="0 0 0">
      <joint name="slider" type="slide" axis="1 0 0" limited="false"/>
      <inertial pos="0 0 0" mass="1.0" diaginertia="0.001 0.001 0.001"/>
      <geom type="box" size="0.1 0.05 0.05" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1"/>
      <body name="pole" pos="0 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0" limited="false"/>
        <inertial pos="0 0 0.3" mass="0.2" diaginertia="0.006 0.006 0.0001"/>
        <geom type="cylinder" fromto="0 0 0  0 0 0.6" size="0.02" contype="0" conaffinity="0" rgba="0.8 0.3 0.3 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="force" joint="slider" gear="1" ctrllimited="true" ctrlrange="-20 20"/>
  </actuator>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
  
</mujoco>
